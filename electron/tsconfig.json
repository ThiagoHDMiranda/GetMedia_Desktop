{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "../dist-electron",
    "paths": { "@/*": ["../src/*"] },
    "resolveJsonModule": true,
    "rootDir": "..",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2020",
    "types": ["node", "electron"]
  },
  "exclude": ["../node_modules", "../dist-electron", "../dist", "../release"],
  "include": ["./**/*.ts", "../src/lib/binaries.ts", "../src/lib/ytdlp-errors.ts", "../src/lib/ytdlp-utils.ts"]
}
